# Required — Claude is used to produce the structured representment workup.
ANTHROPIC_API_KEY=

# Optional — overrides the default Claude model.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional — enables LlamaParse for layout-aware parsing with line/cell
# grounding (best highlight precision). If unset, the app falls back to
# LiteParse for local parsing + bounding boxes (no cloud dependency).
LLAMA_CLOUD_API_KEY=
